# Copy outside Git. Keep the containing directory readable only by your Windows account.
# Root .env + scripts/Start-IcareLocal.ps1 is the unified local setup; see agents/ENVIRONMENT_RUNBOOK.md.
# One email works. Add the second email on the same line, separated by a comma.
ICARE_DB_USER=
ICARE_DB_PASSWORD=
JWT_SECRET=
ICARE_PROXY_SECRET=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ICARE_CORS_ALLOWED_ORIGINS=
# No wildcard. Optional: https://app.example.com,http://127.0.0.1:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
KAKAO_REST_API_KEY=
# Explicit one-time admin setup only after review; use an allowed email as the username.
ICARE_ADMIN_BOOTSTRAP_ENABLED=false
ICARE_ADMIN_BOOTSTRAP_EMAIL=
ICARE_ADMIN_BOOTSTRAP_PASSWORD=
