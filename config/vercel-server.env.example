# Server runtime variables only. Never prefix these names with NEXT_PUBLIC_.
BACKEND_URL=https://backend.example.com
ICARE_FRONTEND_ORIGIN=https://app.example.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ICARE_PROXY_SECRET=
# For local `next dev`: set ICARE_FRONTEND_ORIGIN to the exact browser origin (including port).
# Example: http://127.0.0.1:3000. BACKEND_URL=http://127.0.0.1:8080, Access headers may be omitted.
