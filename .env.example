# Copy to .env in the repository root. Actual .env is ignored by Git.
# Single-line KEY=value or KEY='literal value'. Quote values containing $, # or spaces.
# Verify the API project's Free tier in AI Studio before calls; no billing changes are needed.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Keep embedding model/dimensions fixed; changing them requires a separate data migration.
JWT_SECRET=
ICARE_PROXY_SECRET=
ICARE_DB_URL=jdbc:postgresql://127.0.0.1:5432/parenting_db
ICARE_DB_USER=
ICARE_DB_PASSWORD=
ICARE_DB_PORT=5432
ICARE_DB_VOLUME=
ICARE_DB_NETWORK=icare-local-db_default
ICARE_REDIS_HOST=127.0.0.1
ICARE_REDIS_PORT=6379
ICARE_REDIS_PASSWORD=
ICARE_REDIS_DATABASE=0
ICARE_REDIS_PREFIX=icare:v1:
ICARE_UPLOAD_DIR=
# compose.backend.yml uses .env by default. Optional external runtime override:
# ICARE_BACKEND_ENV_FILE=C:/Users/YOUR_NAME/.icare/local-db/private-backend.env

# Browser -> Next /api -> backend. No NEXT_PUBLIC_ prefix on server secrets.
BACKEND_URL=http://127.0.0.1:8080
ICARE_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Empty denies cross-origin backend requests. Proxy server requests need no CORS.
# Optional exact origins, comma-separated, no slash/path/wildcard:
ICARE_CORS_ALLOWED_ORIGINS=
# Example: ICARE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,https://app.example.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
KAKAO_REST_API_KEY=
# Public JavaScript key for the browser map only; never put REST/API secrets here.
NEXT_PUBLIC_KAKAO_MAP_KEY=
ICARE_AI_MAX_INPUT_CHARS=4000
ICARE_AI_MAX_OUTPUT_TOKENS=1024
ICARE_AI_CALLS_PER_MINUTE=5
ICARE_ADMIN_BOOTSTRAP_ENABLED=false
ICARE_ADMIN_BOOTSTRAP_EMAIL=
ICARE_ADMIN_BOOTSTRAP_PASSWORD=
